---
import { site } from '../data/site';
import { url } from '../utils';

const nav = [
  { label: 'Work', href: 'work' },
  { label: 'Tools & Tips', href: 'tools' },
  { label: 'About', href: 'about' },
  { label: 'Contact', href: 'contact' },
];
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/|\/$/g, '');
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="container">
    <div class="bar glass">
      <a class="brand" href={url()} aria-label={`${site.name}, home`}>
        <span class="mark" aria-hidden="true">K</span>
        <span>{site.name}<span class="accent">.</span></span>
      </a>
      <nav aria-label="Main">
        <ul id="menu">
          {nav.map((item) => (
            <li><a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="btn primary cta" href={url('contact')}>Let's talk</a>
      <button class="menu-btn" type="button" aria-controls="menu" aria-expanded="false" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  btn?.addEventListener('click', () => {
    const open = header!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>

<style>
  .site-header { position: fixed; top: 0.9rem; left: 0; right: 0; z-index: 50; }
  .bar {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem; border-radius: 999px;
    background: var(--glass-strong);
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font: 600 1.15rem var(--font-display); letter-spacing: -0.02em; margin-right: auto; }
  .mark {
    display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--orange); color: #141414; font-size: 1rem; font-weight: 700;
  }
  ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  nav a {
    display: block; padding: 0.5rem 0.9rem; border-radius: 999px;
    color: var(--muted); text-decoration: none; font-size: 0.93rem;
    transition: color 0.2s, background 0.2s;
  }
  nav a:hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  nav a[aria-current='page'] { color: var(--text); background: rgba(255, 255, 255, 0.08); }
  nav a[aria-current='page']::before { content: '• '; color: var(--orange); }
  .cta { padding: 0.6rem 1.1rem; }
  .menu-btn { display: none; }

  @media (max-width: 820px) {
    .cta { display: none; }
    .menu-btn {
      display: grid; place-content: center; gap: 5px;
      width: 2.6rem; height: 2.6rem; border-radius: 50%;
      background: rgba(255, 255, 255, 0.06); border: 1px solid var(--line); cursor: pointer;
    }
    .menu-btn span { display: block; width: 16px; height: 1.5px; background: var(--text); transition: transform 0.3s var(--ease); }
    .open .menu-btn span:first-child { transform: translateY(3.25px) rotate(45deg); }
    .open .menu-btn span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
    .bar { flex-wrap: wrap; border-radius: 26px; }
    nav { order: 3; width: 100%; display: none; }
    .open nav { display: block; }
    .open .bar { background: rgba(25, 25, 27, 0.94); }
    ul { flex-direction: column; padding: 0.5rem 0 0.4rem; }
    nav a { font-size: 1.1rem; padding: 0.7rem 0.9rem; }
  }
</style>
