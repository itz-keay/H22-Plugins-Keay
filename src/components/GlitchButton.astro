---
// A small tab on the right edge. Clicking it turns the whole page into a
// glitchy mess for two seconds, then puts everything back exactly as it was.
---
<button class="glitch-btn" type="button" aria-label="Glitch the page for 2 seconds (just for fun)" title="Don't press this">
  <span class="dot" aria-hidden="true"></span>
  <span class="label" aria-hidden="true">glitch</span>
</button>

<script>
  import { glitch } from '../scripts/glitch';
  document.querySelector('.glitch-btn')?.addEventListener('click', () => glitch(2000));
</script>

<style>
  .glitch-btn {
    position: fixed; right: 0; top: 50%; z-index: 90;
    transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.55rem;
    padding: 0.9rem 0.5rem 0.8rem;
    border: 1px solid var(--line); border-right: 0;
    border-radius: 14px 0 0 14px;
    background: var(--glass-strong);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    color: var(--muted); cursor: pointer;
    transition: color 0.2s, padding 0.25s var(--ease), background 0.2s;
  }
  .glitch-btn:hover { color: var(--text); padding-right: 0.8rem; background: rgba(44, 44, 48, 0.85); }
  .label { writing-mode: vertical-rl; transform: rotate(180deg); font: 0.7rem var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 10px var(--orange); animation: pulse 2s ease-in-out infinite; }
  .glitch-btn:hover .dot { animation-duration: 0.3s; }
  @keyframes pulse { 50% { opacity: 0.35; } }
</style>
