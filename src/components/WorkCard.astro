---
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils';

interface Props { item: CollectionEntry<'work'>; index?: number; large?: boolean }
const { item, index = 0, large = false } = Astro.props;
const { title, client, year, category, summary, cover, tone } = item.data;
---
<article class={`card ${large ? 'large' : ''}`} data-reveal data-category={category} style={`transition-delay:${(index % 3) * 80}ms`}>
  <a href={url(`work/${item.id}`)} class="cover-link" aria-label={`${title}: ${summary}`}>
    <div class={`cover tone-${tone}`}>
      {cover ? <img src={url(cover)} alt="" loading="lazy" /> : (
        <div class="art" aria-hidden="true">
          <span class="ring"></span>
          <span class="word">{title}</span>
        </div>
      )}
      <span class="view">View case <span>↗</span></span>
    </div>
  </a>
  <div class="meta">
    <div>
      <h3>{title}</h3>
      <p class="muted">{client}</p>
    </div>
    <div class="tags">
      <span class="chip">{category}</span>
      <span class="chip">{year}</span>
    </div>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 1rem; }
  .cover-link { display: block; border-radius: var(--radius); text-decoration: none; color: inherit; }
  .cover {
    position: relative; overflow: hidden; aspect-ratio: 4 / 3;
    border-radius: var(--radius); border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .large .cover { aspect-ratio: 16 / 10; }
  .cover img, .art { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .cover-link:hover .cover img, .cover-link:hover .art { transform: scale(1.04); }

  .art { position: relative; display: grid; place-items: center; }
  .tone-slate .art { background: radial-gradient(120% 90% at 20% 10%, #45454c, #232326 60%, #1a1a1c); }
  .tone-ember .art { background: radial-gradient(120% 90% at 80% 10%, #ff7a3d, #b8431a 45%, #2a1a14 90%); }
  .tone-ash .art { background: linear-gradient(135deg, #d8d6d2, #9c9a96 55%, #5e5d5a); }
  .ring {
    position: absolute; width: 58%; aspect-ratio: 1; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: 0 0 0 3.5rem rgba(255, 255, 255, 0.03), 0 0 0 7rem rgba(255, 255, 255, 0.02);
  }
  .tone-slate .ring { border-color: rgba(255, 107, 44, 0.6); }
  .tone-slate .word { mix-blend-mode: normal; color: rgba(236, 235, 232, 0.88); }
  .tone-ash .ring { border-color: rgba(20, 20, 20, 0.35); }
  .word { position: relative; font: 600 clamp(2rem, 6vw, 4.2rem) var(--font-display); letter-spacing: -0.05em; color: rgba(255, 255, 255, 0.92); mix-blend-mode: overlay; }
  .tone-ash .word { color: #1a1a1c; mix-blend-mode: normal; opacity: 0.8; }

  .view {
    position: absolute; left: 1rem; bottom: 1rem;
    padding: 0.55rem 1rem; border-radius: 999px; font-size: 0.85rem;
    background: rgba(25, 25, 27, 0.55); border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    opacity: 0; transform: translateY(8px); transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .view span { color: var(--orange); }
  .cover-link:hover .view, .cover-link:focus-visible .view { opacity: 1; transform: none; }
  @media (hover: none) { .view { opacity: 1; transform: none; } }

  .meta { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
  h3 { font-size: 1.4rem; }
  .meta p { margin: 0.2rem 0 0; font-size: 0.92rem; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: end; }
</style>
