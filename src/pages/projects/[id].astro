---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, formatDate } from '../../utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { title, summary, date, tags, image, demo, source } = project.data;
const { Content } = await render(project);
---
<Base title={title} description={summary}>
  <article class="container page">
    <a class="back" href={url('projects')}>← All projects</a>
    <p class="muted">{formatDate(date)}</p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>
    {(demo || source) && (
      <div class="actions">
        {demo && <a class="btn primary" href={demo} target="_blank" rel="noopener">Live demo ↗</a>}
        {source && <a class="btn" href={source} target="_blank" rel="noopener">Source code ↗</a>}
      </div>
    )}
    {image && <img class="cover" src={url(image)} alt="" />}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .page { padding: 3rem 1.25rem 4rem; }
  .back { display: inline-block; margin-bottom: 2rem; text-decoration: none; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: .2rem 0 .6rem; }
  .lead { font-size: 1.2rem; color: var(--muted); max-width: 40rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.5rem 0; }
  .cover { border-radius: var(--radius); border: 1px solid var(--border); margin: 2rem 0; }
</style>
