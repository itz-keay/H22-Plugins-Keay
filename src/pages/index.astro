---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { url, formatDate } from '../utils';

const work = (await getCollection('work', ({ data }) => !data.draft && data.featured)).sort((a, b) => a.data.order - b.data.order);
const tips = (await getCollection('tips', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const marquee = ['Brand identity', 'UI / UX', 'Design systems', 'Motion', 'Art direction', 'Web design'];
---
<Base>
  <section class="hero container">
    <p class="eyebrow">{site.availability}</p>
    <h1 class="wordmark">
      <span class="line">{site.name}<span class="accent">—</span></span>
      <span class="line outline">{site.role}</span>
    </h1>
    <div class="hero-foot">
      <div class="intro glass">
        <p>{site.intro}</p>
        <div class="actions">
          <a class="btn primary" href={url('work')}>See my work <span class="arrow">→</span></a>
          <a class="btn" href={url('about')}>About me</a>
        </div>
      </div>
      <a class="scroll muted" href="#work">Scroll <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[...marquee, ...marquee].map((m) => <span>{m}<i>✦</i></span>)}
    </div>
  </div>

  <section id="work" class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Recent projects</h2>
      </div>
      <a class="link" href={url('work')}>All work →</a>
    </div>
    <div class="work-grid">
      {work.map((item, i) => <WorkCard item={item} index={i} large={i === 0} />)}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow">What I do</p>
        <h2>Services</h2>
      </div>
    </div>
    <div class="services">
      {site.services.map((s, i) => (
        <div class="service glass" data-reveal style={`transition-delay:${i * 70}ms`}>
          <span class="num">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p class="muted">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Tools & Tips</p>
        <h2>Notes from the studio</h2>
      </div>
      <a class="link" href={url('tools')}>All tips →</a>
    </div>
    <div class="tips">
      {tips.map((t) => (
        <a class="tip glass" href={url(`tools/${t.id}`)} data-reveal>
          <span class="chip">{t.data.tag}</span>
          <h3>{t.data.title}</h3>
          <p class="muted">{t.data.summary}</p>
          <span class="date muted">{formatDate(t.data.date)}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-top: 7rem; padding-bottom: 3rem; }
  .wordmark { font-size: clamp(4.2rem, 17vw, 15rem); line-height: 0.86; letter-spacing: -0.06em; margin: 1.5rem 0 2.5rem; }
  .line { display: block; }
  .outline { color: transparent; -webkit-text-stroke: 1.5px rgba(236, 235, 232, 0.55); }
  .hero-foot { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .intro { max-width: 34rem; padding: 1.5rem 1.6rem; font-size: 1.1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.5rem; }
  .scroll { text-decoration: none; font: 0.8rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }

  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding: 1.3rem 0; background: rgba(255, 255, 255, 0.015); }
  .track { display: flex; width: max-content; animation: marquee 30s linear infinite; }
  .track span { display: flex; align-items: center; gap: 2.5rem; padding-right: 2.5rem; font: 500 clamp(1.4rem, 3vw, 2.2rem) var(--font-display); letter-spacing: -0.02em; white-space: nowrap; color: var(--muted); }
  .track i { font-style: normal; color: var(--orange); font-size: 0.7em; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem 1.75rem; }
  .work-grid :global(.large) { grid-column: 1 / -1; }
  @media (max-width: 720px) { .work-grid { grid-template-columns: 1fr; } }

  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .service { padding: 1.75rem; min-height: 15rem; display: flex; flex-direction: column; transition: border-color 0.3s, transform 0.3s var(--ease); }
  .service:hover { border-color: rgba(255, 107, 44, 0.5); transform: translateY(-4px); }
  .num { font: 0.8rem var(--font-mono); color: var(--orange); margin-bottom: auto; }
  .service h3 { font-size: 1.45rem; margin: 2.5rem 0 0.6rem; }
  .service p { margin: 0; font-size: 0.95rem; }

  .tips { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1rem; }
  .tip { padding: 1.6rem; text-decoration: none; display: flex; flex-direction: column; gap: 0.8rem; transition: border-color 0.3s, transform 0.3s var(--ease); }
  .tip:hover { border-color: rgba(255, 107, 44, 0.5); transform: translateY(-4px); }
  .tip .chip { align-self: start; }
  .tip h3 { font-size: 1.35rem; }
  .tip p { margin: 0; }
  .date { font: 0.78rem var(--font-mono); margin-top: auto; }
</style>
