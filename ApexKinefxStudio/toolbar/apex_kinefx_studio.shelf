<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- ApexKinefxStudio shelf. Every tool calls into the apex_studio Python package. -->
  <toolshelf name="apex_kinefx_studio" label="ApexKinefxStudio">
    <memberTool name="aks_retarget"/>
    <memberTool name="aks_biped"/>
    <memberTool name="aks_snake"/>
    <memberTool name="aks_insect"/>
    <memberTool name="aks_spider"/>
    <memberTool name="aks_quadruped"/>
    <memberTool name="aks_bird"/>
    <memberTool name="aks_jellyfish"/>
    <memberTool name="aks_car"/>
    <memberTool name="aks_bike"/>
    <memberTool name="aks_tank"/>
    <memberTool name="aks_stadium"/>
    <memberTool name="aks_crowd"/>
    <memberTool name="aks_validate"/>
    <memberTool name="aks_mcp_bridge"/>
  </toolshelf>

  <tool name="aks_retarget" label="Retarget FBX" icon="KINEFX_retarget">
    <script scriptType="python"><![CDATA[
import hou
from apex_studio import retarget
src = hou.ui.selectFile(title="Animated source FBX (Mixamo, Cascadeur...)", pattern="*.fbx")
if src:
    tgt = hou.ui.selectFile(title="Target character FBX", pattern="*.fbx")
    if tgt:
        retarget.build_retarget(hou.text.expandString(src), hou.text.expandString(tgt))
]]></script>
  </tool>

  <tool name="aks_biped" label="Biped Rig" icon="KINEFX_skeleton">
    <script scriptType="python"><![CDATA[
import hou
from apex_studio.rigging import bipeds
sel = hou.selectedNodes()
mesh = sel[0].displayNode() if sel and sel[0].type().category() == hou.objNodeTypeCategory() else (sel[0] if sel else None)
bipeds.build_biped(mesh)
]]></script>
  </tool>

  <tool name="aks_snake" label="Snake" icon="SOP_curve">
    <script scriptType="python"><![CDATA[
from apex_studio.rigging import creatures
creatures.build_snake()
]]></script>
  </tool>

  <tool name="aks_insect" label="Insect" icon="KINEFX_skeleton">
