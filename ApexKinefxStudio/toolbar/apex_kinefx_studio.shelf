  <tool name="aks_car" label="Car" icon="SOP_box">
    <script scriptType="python"><![CDATA[
import hou
from apex_studio.rigging import vehicles
sel = hou.selectedNodes()
model = sel[0].displayNode() if sel and sel[0].type().category() == hou.objNodeTypeCategory() else None
vehicles.build_vehicle(model, vehicle_type="car", name="aks_car")
]]></script>
  </tool>

  <tool name="aks_bike" label="Bike" icon="SOP_box">
    <script scriptType="python"><![CDATA[
import hou
from apex_studio.rigging import vehicles
sel = hou.selectedNodes()
model = sel[0].displayNode() if sel and sel[0].type().category() == hou.objNodeTypeCategory() else None
vehicles.build_vehicle(model, vehicle_type="bike", name="aks_bike", speed=15.0)
]]></script>
  </tool>

