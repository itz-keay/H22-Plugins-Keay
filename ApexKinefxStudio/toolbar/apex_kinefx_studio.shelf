  <tool name="aks_validate" label="Validate" icon="BUTTONS_check">
    <script scriptType="python"><![CDATA[
import apex_studio.validate as v
v.report(verbose=True)
]]></script>
  </tool>

  <tool name="aks_mcp_bridge" label="Start MCP Bridge" icon="NETWORKS_chop">
    <script scriptType="python"><![CDATA[
import hou
import apex_studio.bridge as b
port = b.start()
hou.ui.displayMessage(f"ApexKinefxStudio MCP bridge listening on 127.0.0.1:{port}")
]]></script>
  </tool>
</shelfDocument>
