// ApexKinefxStudio - foot contact detection + locking.   SOP Solver step, Detail
//
// Input 0: previous frame (state).  Input 1: current animated skeleton.
// Feet are listed by name; the two joints above each foot are treated as
// thigh/knee and solved with two-bone IK so the foot stays pinned while in
// contact. Contact = foot below `height_threshold` above `ground_height` and
// moving slower than `speed_threshold`. The lock blends in/out over
// `blend_time` seconds to avoid pops.
#include "aks_skeleton.h"
#include "aks_ik.h"

int par[] = aks_parents(1);
int order[] = aks_topo_order(par);
int n = npoints(1);
matrix W[] = aks_load_world(1);
matrix W_old[] = W;
int changed[];
resize(changed, n);

float dt = max(@TimeInc, 1e-6);
float hth = chf("height_threshold");
float vth = chf("speed_threshold");
float ground = chf("ground_height");
float blend_step = dt / max(chf("blend_time"), 1e-4);
int first = !haspointattrib(0, "aks_lockw");

foreach (string foot; split(chs("feet"), " "))
{
    int f = aks_find(1, foot);
    if (f < 0) continue;
    int kn = par[f];
    int th = kn >= 0 ? par[kn] : -1;
    if (th < 0) continue;

    vector raw = aks_pos(W[f]);
    vector prev_raw = raw;
    int locked = 0;
    vector lockp = raw;
    float w = 0.0;
    if (!first)
    {
        prev_raw = point(0, "aks_prev_raw", f);
        locked = point(0, "aks_locked", f);
        lockp = point(0, "aks_lockpos", f);
        w = point(0, "aks_lockw", f);
    }
    float speed = length(raw - prev_raw) / dt;
    int contact = (raw.y - ground) < hth && speed < vth;

    if (contact && !locked)
    {
        lockp = raw;
        lockp.y = max(lockp.y, ground);
        locked = 1;
    }
    else if (!contact)
        locked = 0;
    w = clamp(w + (locked ? blend_step : -blend_step), 0, 1);

    setpointattrib(0, "aks_prev_raw", f, raw);
    setpointattrib(0, "aks_lockpos", f, lockp);
    setpointattrib(0, "aks_locked", f, locked);
    setpointattrib(0, "aks_lockw", f, w);
    if (w <= 0) continue;

    vector target = lerp(raw, lockp, smooth(0, 1, w));
    vector p_th = aks_pos(W[th]);
    vector p_kn = aks_pos(W[kn]);
    float l1 = distance(p_th, p_kn);
    float l2 = distance(p_kn, raw);
    vector pole = p_kn + (p_kn - (p_th + raw) * 0.5);
    vector nk, nf;
    aks_two_bone_ik(p_th, l1, l2, target, pole, nk, nf);

    W[th] = aks_aim_world(W[th], p_kn - p_th, nk - p_th);
    W[kn] = aks_set_pos(aks_aim_world(W[kn], raw - p_kn, nf - nk), nk);
    W[f] = aks_set_pos(W[f], nf);
    changed[th] = 1;
    changed[kn] = 1;
    changed[f] = 1;
}
aks_propagate(par, order, changed, W_old, W);
aks_commit(par, W);
