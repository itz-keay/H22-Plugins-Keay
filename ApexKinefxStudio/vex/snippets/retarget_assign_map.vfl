// ApexKinefxStudio - assign source joint names to target joints. Run Over: Points
// The arrays below are generated by retarget.py from the joint mapping
// (core/profiles.auto_map); edit them here to fix a mapping by hand.
string AKS_TARGETS[] = {};
string AKS_SOURCES[] = {};
int idx = find(AKS_TARGETS, s@name);
s@retarget_src = idx >= 0 ? AKS_SOURCES[idx] : "";
